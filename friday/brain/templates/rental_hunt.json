{
  "task_type": "rental_hunt",
  "goal_template": "Ask {target} about the rental: {what}",
  "required_fields": [
    "business_phone|business_name|discovery_query"
  ],
  "default_questions": [
    "What is the rent and deposit?",
    "Is there maintenance or brokerage?",
    "Are bachelors/pets allowed?",
    "When is it available, and when can we visit?"
  ],
  "success_criteria": [
    "rent, deposit, rules and availability answered",
    "visit slots offered"
  ],
  "fan_out": {
    "strategy": "parallel",
    "concurrency": 3,
    "max_targets": 6
  },
  "needs_approval_to_commit": true,
  "safety_rules": [
    "never agree to pay, prepay, give a deposit or accept charges; bring offers back",
    "no token or advance"
  ],
  "target_kind": "business",
  "call_mode": "agent",
  "may_negotiate": false,
  "follow_up_after_h": null
}
