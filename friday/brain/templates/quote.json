{
  "task_type": "quote",
  "goal_template": "Get a comparable quote from {target} for {what}",
  "required_fields": [
    "business_phone|business_name|discovery_query"
  ],
  "default_questions": [
    "What is the total price?",
    "What is included (taxes, materials, insurance)?",
    "When can you do it?"
  ],
  "success_criteria": [
    "comparable quote with inclusions",
    "negotiated within budget"
  ],
  "fan_out": {
    "strategy": "sequential",
    "concurrency": 3,
    "max_targets": 4
  },
  "needs_approval_to_commit": true,
  "may_negotiate": true,
  "safety_rules": [
    "never agree to pay, prepay, give a deposit or accept charges; bring offers back",
    "site-survey visits need the user's approval"
  ],
  "target_kind": "business",
  "call_mode": "agent",
  "follow_up_after_h": null
}
