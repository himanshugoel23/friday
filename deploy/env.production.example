# =============================================================================
# Friday private-beta production environment  (copy to /etc/friday/.env ON THE SERVER)
#
#   sudo install -d -m 750 /etc/friday
#   sudo cp deploy/env.production.example /etc/friday/.env
#   sudo chmod 600 /etc/friday/.env  &&  sudo nano /etc/friday/.env
#
# RULES
#  * This file in git holds NAMES and PLACEHOLDERS only. Type the real secrets directly
#    into /etc/friday/.env on the server. Never paste them in chat, email, tickets or git.
#  * No quotes and no spaces around "=". A comment after a value needs a space before the "#".
#  * Every value written CHANGE_ME must be replaced. `friday check` names what is missing.
#  * Generate the random ones on the server:  openssl rand -hex 32   (hex only: safe in URLs)
#  * Keep an offline copy of this file (password manager). If FRIDAY_FIELD_KEY is lost,
#    the encrypted data in the database CANNOT be read again.
# =============================================================================

# ---------------------------------------------------------------- 1. Platform
FRIDAY_MODE=live
FRIDAY_PROFILE=beta                 # beta = private-beta production (see friday/core/config.py)
FRIDAY_ENV=prod
FRIDAY_LOG_LEVEL=INFO               # DEBUG is refused in live mode
FRIDAY_LOG_JSON=true
FRIDAY_INVITE_ONLY=true             # must stay true in the beta
FRIDAY_TERMS_URL=https://CHANGE_ME/terms          # required: shown in the onboarding consent message
FRIDAY_PRIVACY_URL=https://CHANGE_ME/privacy      # required
FRIDAY_GRIEVANCE_EMAIL=CHANGE_ME@your-domain      # required: Grievance Officer contact
FRIDAY_GRIEVANCE_NAME=                            # optional: the Officer's name
# Your own WhatsApp number(s), E.164, JSON list: they skip the invite step. Friends use invite codes.
FRIDAY_ADMIN_PHONES=["+91CHANGE_ME"]

# ---------------------------------------------------------------- 2. Domain and HTTPS (Caddy)
FRIDAY_DOMAIN=friday.example.com           # CHANGE_ME: your domain, DNS A record -> static IP
ACME_EMAIL=you@example.com                 # CHANGE_ME: Let's Encrypt expiry notices go here
FRIDAY_PUBLIC_BASE_URL=https://friday.example.com    # CHANGE_ME: same domain, https, NO trailing slash

# ---------------------------------------------------------------- 3. Database and cache (inside Docker)
# Used by docker-compose.prod.yml to build FRIDAY_DATABASE_URL / REDIS_URL. Hex only.
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ---------------------------------------------------------------- 4. Friday's own secrets (all different)
FRIDAY_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32      # signs webhook/media URL tokens
FRIDAY_PIN_PEPPER=CHANGE_ME_openssl_rand_hex_32      # PIN hashing pepper (changing it locks all PINs)
FRIDAY_INDEX_KEY=CHANGE_ME_openssl_rand_hex_32       # phone-number blind index (changing it breaks lookups)
FRIDAY_FIELD_KEY=CHANGE_ME_openssl_rand_hex_32       # field encryption key. BACK IT UP. See docs/DEPLOY_AWS.md
FRIDAY_ADMIN_TOKEN=CHANGE_ME_openssl_rand_hex_32     # bearer token for GET /admin/health

# ---------------------------------------------------------------- 5. LLM brain  REQUIRED (one of the two keys)
# ANTHROPIC_API_KEY (Claude) or OPENAI_API_KEY (GPT); auto picks Anthropic first. Pin with
# FRIDAY_LLM_PROVIDER=openai to force GPT. See the "LLM vendor" item in docs/PRODUCTION_CHECKLIST.md.
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=
FRIDAY_LLM_PROVIDER=auto

# ---------------------------------------------------------------- 6. Sarvam (speech to text / text to speech)  REQUIRED
SARVAM_API_KEY=CHANGE_ME
# Optional: Friday's speaking pace, 1.0 = normal (default), 0.9 = slower, 1.1 = faster. Leave it
# out until you have listened to audio samples and chosen. Env var: FRIDAY_TTS_SPEAKING_RATE
# FRIDAY_TTS_SPEAKING_RATE=1.0

# ---------------------------------------------------------------- 7. Vobiz (phone calls)  REQUIRED
FRIDAY_TELEPHONY_PROVIDER=sarvam
SARVAM_TELEPHONY_AUTH_ID=CHANGE_ME          # Vobiz Account/Auth ID
SARVAM_TELEPHONY_AUTH_TOKEN=CHANGE_ME       # Vobiz Auth Secret
# Numbers you OWN on Vobiz, E.164, comma separated. A dedicated number, not the trial number.
FRIDAY_NUMBERS=+91CHANGE_ME

# ---------------------------------------------------------------- 8. Google Maps Platform  REQUIRED
GOOGLE_PLACES_API_KEY=CHANGE_ME             # Places API (New) + Geocoding API; restrict to the server IP

# ---------------------------------------------------------------- 9. WhatsApp Cloud API (Meta)  REQUIRED
WHATSAPP_ACCESS_TOKEN=CHANGE_ME             # permanent System User token, not the 24-hour test token
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_openssl_rand_hex_16  # you choose it; paste the same in Meta's webhook form
FRIDAY_WHATSAPP_TEMPLATE_LANGUAGE=en
# Logical key -> approved template name in Meta (exact names: docs/PRODUCTION_CHECKLIST.md section 4).
FRIDAY_WHATSAPP_TEMPLATES={"nudge":"friday_nudge_v1","task_update":"friday_task_update_v1","question":"friday_question_v1","reengage":"friday_reengage_v1","beneficiary_optin":"friday_beneficiary_optin","business_booking_declined":"friday_business_declined_v1","business_booking_confirmed":"friday_business_touch","business_enquiry_thanks":"friday_business_thanks_v1"}

# ---------------------------------------------------------------- 10. OPTIONAL: leave empty to keep them OFF
# Hotels (Expedia): empty = hotel tasks are not real (simulator). Do not offer hotels to testers.
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_SHARED_SECRET=
# SMS (MSG91 + DLT registration): empty = no SMS, WhatsApp only.
MSG91_AUTH_KEY=
DLT_ENTITY_ID=
# Recordings: empty = calls are NOT recorded. Set only after the recording decision in the checklist.
# Needs an S3 bucket in ap-south-1 and AWS credentials for the containers (docs/DEPLOY_AWS.md s.12).
FRIDAY_OBJECT_STORE_URL=

# ---------------------------------------------------------------- 11. Safety limits (sensible beta defaults)
FRIDAY_MAX_CONCURRENT_CALLS=2
FRIDAY_CALL_MAX_DURATION_S=300
FRIDAY_NUMBER_MAX_CALLS_PER_DAY=20
FRIDAY_PROACTIVE_DAILY_CAP=2
FRIDAY_COST_ALERT_INR_PER_USER_MONTH=1500

# ---------------------------------------------------------------- 12. Kill switch (normally leave false)
# Day to day use `friday pause` (docs/DEPLOY_AWS.md s.10). true here = paused after every restart.
FRIDAY_PAUSED=false
