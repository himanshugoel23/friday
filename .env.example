# Friday configuration. Copy to .env. EVERYTHING is optional in simulator mode:
# with no .env at all, Friday runs end-to-end with fakes/simulators.
# Never commit real secrets.

# ---------------------------------------------------------------- app
# FRIDAY_PROFILE=pilot: voice-only live test (needs only Vobiz + Sarvam + LLM + secrets + https URL;
# WhatsApp/SMS/hotels/directory use simulators, recordings off). `friday init-env` sets it.
# FRIDAY_PROFILE=beta: small private-beta production on a server (docs/DEPLOY_AWS.md, deploy/env.production.example).
# Live mode then requires LLM + Sarvam + Vobiz (+ caller IDs) + Google Places + WhatsApp Cloud + https URL + admin
# token + Postgres; hotels (Expedia), SMS (MSG91/DLT) and the object store are OPTIONAL (off), recordings stay off.
FRIDAY_PROFILE=default               # default | pilot | beta
# Pilot safety: the ONLY numbers `friday livecall` may dial AND `friday listen` will answer (E.164, comma-separated). Empty = none.
FRIDAY_PILOT_ALLOWED_NUMBERS=
FRIDAY_PILOT_MAX_SPEND_INR=25        # livecall refuses if its cost estimate is higher
# Front door (people calling Friday's number; `friday listen`). All optional, see docs/FRONT_DOOR.md.
# FRIDAY_FRONTDOOR_ENABLED=true
# FRIDAY_FRONTDOOR_OPEN_SIGNUP=false         # outside the pilot: let unknown callers onboard by voice
# FRIDAY_FRONTDOOR_PILOT_MAX_CALL_S=180
# FRIDAY_FRONTDOOR_PER_CALLER_PER_HOUR=3
# FRIDAY_FRONTDOOR_GLOBAL_PER_HOUR=40
# FRIDAY_FRONTDOOR_RESULT_CALLBACKS=true     # ring the caller back with the result of their request
FRIDAY_MODE=simulator                # simulator | live (live = real calls/messages!)
FRIDAY_ENV=dev                       # dev | test | prod
FRIDAY_LOG_LEVEL=INFO
FRIDAY_LOG_JSON=false
FRIDAY_PUBLIC_BASE_URL=http://localhost:8000   # public https URL for provider webhooks in live
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8000
FRIDAY_SECRET_KEY=dev-insecure-change-me      # REQUIRED in live (PIN pepper, encryption)
FRIDAY_DEFAULT_COUNTRY_CODE=+91
FRIDAY_DEFAULT_LANGUAGE=hinglish
FRIDAY_MEDIA_DIR=./var/media

# ---------------------------------------------------------------- database
FRIDAY_DATABASE_URL=sqlite+aiosqlite:///./friday.db   # Postgres: postgresql+asyncpg://user:pw@host/db
FRIDAY_DB_ECHO=false

# ---------------------------------------------------------------- LLM (Anthropic or OpenAI)
# auto: Claude if ANTHROPIC_API_KEY is set, else GPT if OPENAI_API_KEY is set, else the
# deterministic fake (simulator mode only; live mode needs one real key)
FRIDAY_LLM_PROVIDER=auto             # auto | anthropic | openai | fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FRIDAY_LLM_MODEL=claude-opus-5-5     # planning, summaries, nudges, extraction
FRIDAY_LLM_FAST_MODEL=claude-haiku-5-5   # live call turns, intent (latency-critical)
FRIDAY_LLM_TIMEOUT_S=30
FRIDAY_LLM_MAX_RETRIES=2
# OpenAI routing (used when the provider resolves to openai); JSON maps are per purpose
FRIDAY_OPENAI_MODELS={"call_turn":"gpt-5.4-mini","interpret":"gpt-5.4-mini"}
FRIDAY_OPENAI_DEFAULT_PURPOSE_MODEL=gpt-5.4-mini
FRIDAY_OPENAI_ESCALATION_MODEL=gpt-5.4
FRIDAY_OPENAI_REASONING_EFFORT={"call_turn":"low"}
FRIDAY_OPENAI_DEFAULT_REASONING_EFFORT=none
FRIDAY_OPENAI_TIMEOUT_S=30
FRIDAY_OPENAI_CALL_TURN_TIMEOUT_S=8
FRIDAY_OPENAI_MAX_RETRIES=2
FRIDAY_OPENAI_USD_TO_INR=84
# price table: ESTIMATES [input, cached input, output] USD per 1M tokens; verify on OpenAI's pricing page
# FRIDAY_OPENAI_PRICES_USD_PER_MTOK={"gpt-5.4-mini":[0.75,0.075,4.5]}

# ---------------------------------------------------------------- telephony
# Side-effecting: simulator mode ALWAYS uses the simulator, whatever is set here.
# Founder decision: Sarvam-only live telephony for now.
FRIDAY_TELEPHONY_PROVIDER=sarvam     # sarvam (auto = sarvam) | routed | exotel | twilio | plivo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
FRIDAY_CALL_RECORD=true
FRIDAY_CALL_RING_TIMEOUT_S=30
FRIDAY_CALL_MAX_DURATION_S=300
FRIDAY_CALL_MAX_ATTEMPTS=3
FRIDAY_CALL_RETRY_BACKOFF_S=900
FRIDAY_CALL_SILENCE_TIMEOUT_S=8
FRIDAY_MID_CALL_QUESTION_TIMEOUT_S=90
FRIDAY_CALL_HOLD_REMINDER_INTERVAL_S=20
FRIDAY_CALLBACK_AFTER_APPROVAL_DELAY_S=0
FRIDAY_MAX_CONCURRENT_CALLS=5
FRIDAY_FANOUT_DEFAULT_CONCURRENCY=3
FRIDAY_BUSINESS_CALL_WINDOW_START=09:30
FRIDAY_BUSINESS_CALL_WINDOW_END=20:00
FRIDAY_AVOID_LUNCH_WINDOW=13:30-14:30
FRIDAY_IVR_MAX_HOLD_S=1500
FRIDAY_HOLD_USER_UPDATE_INTERVAL_S=300
FRIDAY_CARE_FOLLOWUP_GRACE_H=24
FRIDAY_CHECKIN_DEFAULT_TIME_IST=10:30
FRIDAY_CHECKIN_MAX_DURATION_S=240

# ---------------------------------------------------------------- STT / TTS
# auto: real vendor if its key is set (any mode), fake otherwise
FRIDAY_STT_PROVIDER=auto             # auto | fake | sarvam | deepgram
FRIDAY_TTS_PROVIDER=auto             # auto | fake | sarvam | elevenlabs
SARVAM_API_KEY=
FRIDAY_SARVAM_TTS_SPEAKER=anushka
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FRIDAY_TTS_VOICES={}                 # JSON: {"hi":"<voice>","en":"<voice>","ta":"<voice>"}
# Speaking pace for Friday's voice: 1.0 = normal. Lower = slower (e.g. 0.9), higher = faster (1.1).
# Leave at 1.0 until you have listened to audio samples and chosen. Applies to new speech; fixed
# lines pre-rendered earlier are cached per rate, so they are re-rendered on the next call.
FRIDAY_TTS_SPEAKING_RATE=1.0
FRIDAY_TTS_STYLE=calm
FRIDAY_TTS_VOICE_GENDER=female       # Friday is female

# ---------------------------------------------------------------- WhatsApp Cloud API
FRIDAY_WHATSAPP_PROVIDER=auto        # auto(=cloud in live) | simulator | cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=friday-dev-verify
WHATSAPP_APP_SECRET=
FRIDAY_WHATSAPP_API_VERSION=v21.0
FRIDAY_WHATSAPP_SESSION_WINDOW_H=24
FRIDAY_WHATSAPP_TEMPLATES={"nudge":"friday_nudge_v1","task_update":"friday_task_update_v1","question":"friday_question_v1","reengage":"friday_reengage_v1"}
FRIDAY_WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------------------------------------------------------------- SMS (DLT)
FRIDAY_SMS_PROVIDER=auto             # auto(=msg91 in live) | fake | msg91
MSG91_AUTH_KEY=
FRIDAY_SMS_SENDER_ID=FRIDAY
DLT_ENTITY_ID=
FRIDAY_SMS_DLT_TEMPLATES={"business_booking_confirmed":"DLT_TPL_BIZ_BOOKING","business_enquiry_thanks":"DLT_TPL_BIZ_ENQUIRY","user_task_update":"DLT_TPL_USER_UPDATE","user_reminder":"DLT_TPL_USER_REMINDER"}

# ---------------------------------------------------------------- discovery & safety
FRIDAY_DIRECTORY_PROVIDER=auto       # auto(real if key) | simulator | google_places
FRIDAY_GEOCODER_PROVIDER=auto        # auto(real if key) | simulator | google
GOOGLE_PLACES_API_KEY=               # Maps Platform key: Places API (New) + Geocoding
FRIDAY_DISCOVERY_MAX_CANDIDATES=10
FRIDAY_DISCOVERY_SHORTLIST_SIZE=3
FRIDAY_DISCOVERY_MIN_RATING=3.8
FRIDAY_VERIFY_NUMBERS=true
FRIDAY_SCAM_NUMBERS_PATH=
FRIDAY_OFFICIAL_NUMBERS_PATH=

# ---------------------------------------------------------------- hotels
FRIDAY_HOTEL_PROVIDER=auto           # auto(=expedia_rapid in live) | simulator | expedia_rapid
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_SHARED_SECRET=
FRIDAY_EXPEDIA_RAPID_BASE_URL=https://test.ean.com/v3
FRIDAY_HOTEL_SHORTLIST_SIZE=3
FRIDAY_HOTEL_RECONFIRM_HOUR_IST=11

# ---------------------------------------------------------------- proactive
FRIDAY_PROACTIVE_ENABLED=true
FRIDAY_PROACTIVE_TICK_S=60
FRIDAY_PROACTIVE_DAILY_CAP=3
FRIDAY_QUIET_HOURS_START=22
FRIDAY_QUIET_HOURS_END=8
FRIDAY_MORNING_BRIEFING_HOUR=8
FRIDAY_IGNORE_LEARNING_THRESHOLD=3
FRIDAY_TASK_REMINDER_LEAD_MIN=120
FRIDAY_FOLLOW_UP_DELAY_H=24

# ---------------------------------------------------------------- access
FRIDAY_INVITE_ONLY=true
FRIDAY_TERMS_URL=
FRIDAY_PRIVACY_URL=
FRIDAY_GRIEVANCE_EMAIL=
FRIDAY_GRIEVANCE_NAME=
FRIDAY_INVITES_PER_USER=5
# No user-facing usage cap in beta. Ops-only abuse limit (off) + cost alerts.
FRIDAY_ABUSE_RATE_LIMIT_ENABLED=false
FRIDAY_ABUSE_MAX_CALLS_PER_DAY=30
FRIDAY_COST_ALERT_INR_PER_USER_MONTH=1500
FRIDAY_PIN_MAX_ATTEMPTS=5
FRIDAY_ADMIN_PHONES=[]               # JSON list of E.164 numbers that skip the invite step

# Ops (beta/prod): bearer token for GET /admin/health and /admin/numbers (live mode: admin routes are
# disabled without it). Kill switch: `friday pause` / `friday pause --resume`; the flag file is shared by all
# containers, or set FRIDAY_PAUSED=true to stay paused across restarts.
FRIDAY_ADMIN_TOKEN=
FRIDAY_PAUSED=false
FRIDAY_PAUSE_FILE=./var/PAUSED

# ---------------------------------------------------------------- simulator
FRIDAY_SIM_SEED=7
FRIDAY_SIM_BUSINESS_ANSWER_RATE=1.0

# ---------------------------------------------------------------- Stage 3 additions
# LLM routing (founder cost rule): Haiku default, Sonnet for live call turns, Opus only on escalation
FRIDAY_LLM_MODELS={"call_turn":"claude-sonnet-5-5","interpret":"claude-haiku-5-5"}
FRIDAY_LLM_DEFAULT_PURPOSE_MODEL=claude-haiku-5-5
FRIDAY_LLM_ESCALATION_MODEL=claude-opus-5-5
FRIDAY_LLM_TASK_TOKEN_BUDGET=60000
FRIDAY_LLM_PROMPT_CACHING=true
FRIDAY_LLM_BATCH_ENABLED=true

# Telephony (live): Sarvam only. Caller IDs: FRIDAY_NUMBERS (or SARVAM_CALLER_IDS) is REQUIRED.
# Only used with FRIDAY_TELEPHONY_PROVIDER=routed (failover router)
FRIDAY_TELEPHONY_ROUTE=sarvam
FRIDAY_SARVAM_VERIFIED_CAPABILITIES=   # e.g. bridge_transfer (confirmed with Sarvam)
SARVAM_TELEPHONY_AUTH_ID=
SARVAM_TELEPHONY_AUTH_TOKEN=
FRIDAY_SARVAM_TELEPHONY_BASE_URL=https://api.vobiz.ai/api/v1
SARVAM_CALLER_IDS=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_VOICEBOT_APP_ID=
EXOTEL_CALLER_IDS=
FRIDAY_INBOUND_CLAIM_TIMEOUT_S=10

# Caller-ID pool (bootstrap list; CSV or JSON) + reputation limits
FRIDAY_NUMBERS=
FRIDAY_NUMBER_MAX_CALLS_PER_HOUR=15
FRIDAY_NUMBER_MAX_CALLS_PER_DAY=80
FRIDAY_NUMBER_MAX_CONCURRENT=2
FRIDAY_NUMBER_MIN_GAP_S=45
FRIDAY_NUMBER_WARMUP_DAILY_CAPS=[10,20,35,50,65]
FRIDAY_NUMBER_MIN_ANSWER_RATE=0.35
FRIDAY_NUMBER_MAX_SHORT_CALL_RATE=0.30
FRIDAY_NUMBER_MAX_DNC_RATE=0.03
FRIDAY_NUMBER_COOLDOWN_H=72
FRIDAY_NUMBER_RETIRED_FORWARD_DAYS=30

# Task retry / inbound policy (BRIEF E.30-37)
FRIDAY_TASKS_MAX_ATTEMPTS=3
FRIDAY_TASKS_NO_ANSWER_DELAYS_MIN=[10,45]
FRIDAY_TASKS_BUSY_DELAY_MIN=5
FRIDAY_TASKS_TRY_ALT_NUMBERS=true
FRIDAY_TASKS_MISSED_CALL_NOTIFY_AFTER=3
FRIDAY_TASKS_BETTER_OFFER_PCT=15

# Security keys (SECURITY-30): REQUIRED in live, separate from FRIDAY_SECRET_KEY
FRIDAY_PIN_PEPPER=
FRIDAY_FIELD_KEY=                    # dev/no-KMS local data key
FRIDAY_FIELD_KEY_ID=                 # live: KMS key id/ARN (envelope encryption)
FRIDAY_INDEX_KEY=                    # blind-index HMAC key

# Scale-out: process roles + backends (auto: Postgres queue/locks if DATABASE_URL is Postgres)
FRIDAY_ROLES=api,task,voice,proactive,batch
FRIDAY_QUEUE_BACKEND=auto            # auto | memory | postgres
FRIDAY_LOCK_BACKEND=auto             # auto | memory | postgres | redis
FRIDAY_CACHE_BACKEND=auto            # auto | memory | redis
FRIDAY_RATE_LIMIT_BACKEND=auto       # auto | memory | redis
REDIS_URL=
FRIDAY_DB_POOL_SIZE=10
FRIDAY_DB_MAX_OVERFLOW=10
FRIDAY_OBJECT_STORE_URL=             # s3://bucket/prefix for recordings
FRIDAY_WORKER_CONCURRENCY={"task":32,"voice":50,"proactive":8,"batch":4}
FRIDAY_PROVIDER_CONCURRENCY={"telephony":200,"sarvam":200,"exotel":100,"twilio":50,"stt":300,"tts":300,"llm":200}
FRIDAY_PROVIDER_RATE_PER_S={"telephony":20,"whatsapp":70,"sms":20,"llm":50,"google_places":20}
FRIDAY_LLM_TOKENS_PER_MIN=2000000
FRIDAY_WEBHOOK_IDEMPOTENCY_TTL_H=72
FRIDAY_PROACTIVE_SHARDS=1
FRIDAY_PROACTIVE_SHARD_INDEX=
FRIDAY_SIM_TIME_SCALE=
