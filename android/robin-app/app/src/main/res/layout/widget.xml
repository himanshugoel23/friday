<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: two big buttons. A widget cannot detect a 2-second hold, so each button opens the quick screen
     where the press-and-hold happens (this also prevents a pocket-tap from sending an SOS). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_sos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_sos"
        android:gravity="center"
        android:text="@string/widget_sos"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_voice"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_voice"
        android:gravity="center"
        android:text="@string/widget_voice"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />
</LinearLayout>
