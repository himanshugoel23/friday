<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: one big microphone (tap to talk) and a smaller SOS. A widget cannot record or detect a 2-second
     hold, so each button opens the quick screen: the mic starts listening there at once; SOS is held there (this also
     prevents a pocket-tap from sending an SOS). Both targets are far larger than 48dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_mic"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:layout_weight="2"
        android:background="@drawable/widget_btn_voice"
        android:contentDescription="@string/widget_mic_desc"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="@string/widget_mic"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_sos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_sos"
        android:contentDescription="@string/widget_sos_desc"
        android:gravity="center"
        android:text="@string/widget_sos"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />
</LinearLayout>
